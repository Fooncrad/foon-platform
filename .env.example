# Hostinger environment variables. Never commit real values.
NODE_ENV=production
HOSTNAME=0.0.0.0
SITE_ORIGIN=https://your-domain.example
PLATFORM_ADMIN_EMAIL=your-admin@example.com
INTEGRATION_ENCRYPTION_KEY=generate-a-long-random-secret-once
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SSL=false
# Only for admin:create; remove after provisioning. Minimum 12 characters.
# ADMIN_INITIAL_PASSWORD=
# ACCOUNT_EMAIL=optional-store-user@example.com
# ACCOUNT_DISPLAY_NAME=
# ACCOUNT_TENANT_ID=
# Set true for first deployment; migrations are idempotent and tracked.
RUN_DB_MIGRATIONS=false
